# Copy to .env and fill in. .env is ignored by git; never commit a real key.
# Load it before running:  set -a; source .env; set +a

# mock (offline demo, default) | anthropic | local
CLAUSE_PROVIDER=mock

# Needed only when CLAUSE_PROVIDER=anthropic. The facilitator's key.
ANTHROPIC_API_KEY=
# Model for the hosted provider (the code defaults to claude-sonnet-5-5)
CLAUSE_MODEL=claude-sonnet-5-5

# Parallel model calls (1 = one at a time)
CLAUSE_WORKERS=1

# Spend limit for a hosted run. All three are needed together; take the prices from the price list, none are built in.
CLAUSE_BUDGET_USD=
CLAUSE_PRICE_IN=
CLAUSE_PRICE_OUT=

# SQLite file for the review screen
CLAUSE_DB=review.db
